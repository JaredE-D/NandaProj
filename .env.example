# Copy to .env and fill in the three secrets. .env is gitignored -- never commit it.
#   cp .env.example .env

# --- secrets -------------------------------------------------------------

# vast.ai API key. Account page -> "API Keys". `just balance` verifies it works.
VAST_API_KEY=

# Hugging Face token, "read" scope. Required: Gemma is a gated repo, so without
# this the box provisions fine and then fails the download *after* billing has
# started. Accept the Gemma license on the model page first.
HF_TOKEN=

# Token the remote JupyterLab requires. Any long random string:
#   openssl rand -hex 32
# Jupyter binds to loopback on the box, so the SSH tunnel is the only route in
# and this token is never exposed publicly.
JUPYTER_TOKEN=

# --- budget --------------------------------------------------------------

# Hard spend ceiling in USD. `just burn` warns at 60% and 85% against it.
# `just balance` reports the real vast.ai balance, which is the number that
# actually stops a run.
BUDGET_USD=50

# --- machine selection ---------------------------------------------------

GPU_NAME=RTX_4090
MAX_PRICE=0.50
DISK_GB=40
IMAGE=vastai/pytorch:cuda-12.4.1-auto

# Restrict rentals to hosts near you. Latency is paid on every cell execution
# through the tunnel, and the cross-region price spread is only pennies per
# hour -- so region beats price here.
# Examples: "geolocation in [US,CA]"  /  "geolocation in [DE,NL,SE,FR]"
# Leave empty to rent the cheapest box anywhere.
GEO_FILTER="geolocation in [US,CA]"

# --- safety --------------------------------------------------------------

# Minutes of kernel idleness before the remote watchdog self-destroys the box.
# A busy kernel counts as activity, so a long-running cell will not be killed.
IDLE_KILL_MIN=45

# Local end of the SSH tunnel; `just url` prints the URL for VSCode.
LOCAL_PORT=8888
