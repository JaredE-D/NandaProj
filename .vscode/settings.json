{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // The remote kernel is attached via the command palette:
  //   "Jupyter: Select Interpreter to Start Jupyter Server"  ->  Existing
  // then paste the tunneled URL printed by `just url`.
  // There is no stable settings key for that URL, so it is not set here.
  "jupyter.askForKernelRestart": false,
  "jupyter.interactiveWindow.creationMode": "perFile",

  // Big activation tensors otherwise flood the output pane.
  "notebook.output.textLineLimit": 60,
  "notebook.output.scrolling": true,

  // Keep notebook diffs reviewable in git.
  "notebook.diff.ignoreMetadata": true,
  "notebook.formatOnSave.enabled": false,

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  }
}
